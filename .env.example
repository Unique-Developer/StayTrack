# StayTrack Environment Configuration
PROJECT_NAME="StayTrack"
TAGLINE="Daily Reports. Continuous Insights."

# Security
SECRET_KEY="replace-with-a-strong-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_ADMIN_EMAIL="admin@staytrack.com"
DEFAULT_ADMIN_PASSWORD="StayTrack2026!"

# Database
# Default local SQLite file:
DATABASE_URL="sqlite:///./staytrack.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql+psycopg2://staytrack_user:secure_password@localhost:5432/staytrack"

# File Storage
# Default local storage path:
STORAGE_PATH="./backend/storage/reports"
# For AWS S3 or S3-compatible storage in production:
# S3_BUCKET_NAME="staytrack-private-reports"
# S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Motel Defaults
DEFAULT_PROPERTY_NAME="STUDIO 6 - STAFFORD, VA"
DEFAULT_PROPERTY_CODE="3756"
DEFAULT_TIMEZONE="America/New_York"

# Analytics Defaults
DEFAULT_ROLLING_WINDOW_DAYS=30
DEFAULT_CONTINUOUS_STAY_DAYS=30
DEFAULT_MIN_APPEARANCE_DAYS=3
DEFAULT_DEPARTURE_CONVENTION="checkin_plus_nights"
RETENTION_DAYS=2555
